# =====================================================================
# Konfigurasi Chatbot UAS Literasi Big Data PAI
# =====================================================================
# Salin file ini ke `.env` dan sesuaikan dengan kebutuhan Anda.
# .env TIDAK akan ter-commit ke Git (sudah di .gitignore).

# =====================================================================
# 1. PROVIDER LLM
# =====================================================================

# ----- DEFAULT: Google Gemini -----
# 1M context window, 1M TPM, 250 RPD free tier (cukup untuk kelas 40 mhs).
# Dapatkan API key gratis di: https://aistudio.google.com/apikey
# Tidak perlu kartu kredit.
LLM_PROVIDER=gemini
GEMINI_API_KEY=
LLM_MODEL=gemini-2.5-flash

# Opsi model Gemini (urut kualitas):
#   gemini-2.5-pro       — terbaik, 5 RPM 100 RPD (untuk Pro/paid tier)
#   gemini-2.5-flash     — direkomendasikan, 10 RPM 250 RPD (default)
#   gemini-2.5-flash-lite — paling cepat, 15 RPM 1000 RPD

# Mode prompt: full (Gemini support 1M context, jadi pakai full content)
LLM_PROMPT_MODE=full

# =====================================================================
# 2. PASSWORD AKSES
# =====================================================================
# Password sederhana yang mudah diingat, sudah disiapkan untuk
# kemudahan dosen. Bapak/Ibu BISA ganti sebelum deploy publik.

# Password Dasbor Dosen (untuk akses halaman audit)
DOSEN_PASSWORD=dosen-lbdta-2026

# Password Kelas (mahasiswa input sebelum bisa pakai chatbot)
# Kosongkan jika ingin akses bebas tanpa password.
KELAS_PASSWORD=lbdta-kelas-2026

# =====================================================================
# 3. ALTERNATIF PROVIDER LLM (jika Gemini tidak tersedia)
# =====================================================================

# ----- Groq (gratis, tapi limit 12K TPM butuh LLM_PROMPT_MODE=compact) -----
# https://console.groq.com (login Google)
# LLM_PROVIDER=groq
# GROQ_API_KEY=
# LLM_MODEL=llama-3.3-70b-versatile
# LLM_PROMPT_MODE=compact

# ----- OpenAI -----
# LLM_PROVIDER=openai
# OPENAI_API_KEY=
# LLM_MODEL=gpt-4o-mini

# ----- Anthropic Claude -----
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# LLM_MODEL=claude-3-5-haiku-latest

# ----- Ollama lokal (laptop dosen, RAM ≥16GB) -----
# Install: https://ollama.com  →  ollama pull llama3.2
# LLM_PROVIDER=ollama
# LLM_MODEL=llama3.2

# =====================================================================
# 4. OPSIONAL
# =====================================================================
# Temperature (0.0–1.0). Default 0.4 = lebih konservatif.
# LLM_TEMPERATURE=0.4

# Lokasi database SQLite (default: app/data/sessions.db)
# DB_PATH=app/data/sessions.db
