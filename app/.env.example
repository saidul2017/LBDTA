# =====================================================================
# Konfigurasi LLM untuk Chatbot UAS Literasi Big Data PAI
# =====================================================================
# Salin file ini ke `.env` dan isi salah satu konfigurasi di bawah.

# ----- DEFAULT: Groq (gratis, rekomendasi) -----
# Daftar gratis di https://console.groq.com (login Google).
LLM_PROVIDER=groq
GROQ_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile

# ----- Alternatif: Google Gemini (gratis tier) -----
# https://aistudio.google.com/apikey
# LLM_PROVIDER=gemini
# GEMINI_API_KEY=
# LLM_MODEL=gemini-2.0-flash

# ----- Alternatif: OpenAI -----
# LLM_PROVIDER=openai
# OPENAI_API_KEY=
# LLM_MODEL=gpt-4o-mini

# ----- Alternatif: Anthropic Claude -----
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# LLM_MODEL=claude-3-5-haiku-latest

# ----- Alternatif: Ollama lokal (laptop dosen, RAM ≥16GB) -----
# Install: https://ollama.com  →  ollama pull llama3.2
# LLM_PROVIDER=ollama
# LLM_MODEL=llama3.2

# Opsional: temperature (0.0–1.0). Default 0.4 = lebih konservatif.
# LLM_TEMPERATURE=0.4

# Opsional: lokasi database SQLite (default: app/data/sessions.db)
# DB_PATH=app/data/sessions.db
